{
  "name": "pequenos-discipulos",
  "version": "1.0.0",
  "description": "PWA catequético gamificado para toda a família (crianças, jovens e adultos)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && npm run check:content && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format:content": "python scripts/format-content.py",
    "check:content": "esbuild scripts/check-content.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/check-content.mjs && node node_modules/.cache/check-content.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ederdandan/pequenos-discipulos.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/ederdandan/pequenos-discipulos/issues"
  },
  "homepage": "https://github.com/ederdandan/pequenos-discipulos#readme",
  "dependencies": {
    "lucide-react": "^1.67.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.4",
    "typescript": "5.6",
    "vite": "^6.4.5"
  },
  "private": true
}
